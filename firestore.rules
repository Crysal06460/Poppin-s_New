rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // Super-admins applicatifs (cf. _dashboardAdminEmails /
    // _notificationAdminEmails côté Flutter) : diffusion notifications,
    // écrans admin. Volontairement une liste fermée et courte.
    function isAppAdmin() {
      return isSignedIn() &&
        myEmail() in ['cbeylet06@gmail.com', 'chrisgugu1101@gmail.com'];
    }

    // L'utilisateur appartient à la structure (assmat = uid==structureId,
    // membre MAM / parent = structureId dans son doc)
    function isStructureMember(structureId) {
      return request.auth.uid == structureId ||
             (exists(/databases/$(database)/documents/users/$(myEmail())) &&
              get(/databases/$(database)/documents/users/$(myEmail())).data.structureId == structureId);
    }

    // L'utilisateur est un professionnel (assmat, MAM, admin)
    function isProfessional() {
      return exists(/databases/$(database)/documents/users/$(myEmail())) &&
             get(/databases/$(database)/documents/users/$(myEmail())).data.role in
               ['admin', 'mamMember', 'assistant', 'structure'];
    }

    // Seul un pro peut créer/modifier des comptes parent
    function canManageParentUsers() {
      return isSignedIn() &&
             request.auth.token.email is string &&
             get(/databases/$(database)/documents/users/$(myEmail())).data.role in
               ['admin', 'mamMember', 'assistant', 'structure'];
    }

    // ─── USERS ────────────────────────────────────────────────────────────────
    // Lecture : son propre doc OU professionnel (pour lookup email parent)
    // Écriture : son propre doc OU professionnel créant/modifiant un parent
    match /users/{userId} {
      allow read: if isSignedIn() && (
        userId == request.auth.uid ||
        userId == myEmail() ||
        isProfessional()
      );

      allow write: if isSignedIn() && (
        userId == request.auth.uid ||
        userId == myEmail() ||
        (
          canManageParentUsers() &&
          request.resource.data.role == 'parent' &&
          (resource == null || resource.data.role == 'parent')
        )
      );

      // Mise à jour du badge non-lu uniquement (self-service)
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['unreadMessages']);

      // ─── AI USAGE (quota assistant Calculs IA) ────────────────────────────
      // Jamais accessible côté client : seule la Cloud Function (Admin SDK,
      // qui contourne ces règles) peut lire/écrire le compteur quotidien.
      match /aiUsage/{date} {
        allow read, write: if false;
      }

      // ─── AVENANTS AU CONTRAT ───────────────────────────────────────────────
      // Seul le propriétaire (userId == uid) peut lire/écrire ses avenants.
      // Un seul niveau de sous-collection : doc 'brouillon' (isDraft: true)
      // + avenants finalisés (isDraft: false), cf. AvenantStorageService.
      match /avenants/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // ─── SUBSCRIPTIONS ────────────────────────────────────────────────────────
    // Chaque abonnement est identifié par le structureId.
    // Seul le membre de la structure peut lire/écrire son abonnement.
    // Les Cloud Functions (admin SDK) contournent ces règles → webhooks Stripe OK.
    match /subscriptions/{docId} {
      allow read: if isSignedIn() && isStructureMember(docId);
      allow create, update: if isSignedIn() && isStructureMember(docId);
      allow delete: if false;
    }

    // ─── STRUCTURES ───────────────────────────────────────────────────────────
    // CRITIQUE : données très sensibles (photos, santé, adresses, téléphones)
    // Seul un membre de la structure (assmat, MAM, parent lié) peut accéder.
    match /structures/{structureId} {
      // isAppAdmin() sur la lecture : nécessaire pour
      // firestore.collection('structures').get() (broadcast notifications,
      // outil admin_screen.dart "corriger relations parent-enfant") — une
      // requête sur toute la collection ne peut satisfaire isStructureMember
      // pour aucun compte, donc elle échouait entièrement sans ce cas.
      allow read: if isSignedIn() && (isStructureMember(structureId) || isAppAdmin());
      allow write: if isSignedIn() && isStructureMember(structureId);

      // ⚠️ ROLLBACK URGENCE 2026-07-10 : l'exclusion `documentPath[0] != 'remplacements'`
      // a causé une panne totale (probable erreur d'évaluation à l'exécution sur
      // l'indexation du path, non détectée par la validation de compilation) —
      // reverti à la règle d'origine. La faille remplacements/{id} écrit toujours
      // via le wildcard ci-dessous en attendant un correctif revérifié en sandbox.
      match /{documentPath=**} {
        allow read: if isSignedIn() && isStructureMember(structureId);
        allow write: if isSignedIn() && isStructureMember(structureId);
      }

      // Diffusion admin : StructureNotificationService.broadcast() écrit une
      // notification dans CHAQUE structure, donc l'appelant n'est membre que
      // d'une seule d'entre elles.
      match /notifications/{notificationId} {
        allow write: if isAppAdmin();
      }

      // ─── REMPLACEMENTS (délégation temporaire) ──────────────────────────
      // Écriture : jamais côté client. Seules createRemplacement /
      // activateRemplacementSession / cancelRemplacement / expireRemplacements
      // (Cloud Functions, Admin SDK) écrivent ce document — sinon un membre
      // MAM ou un parent rattaché pourrait forcer son propre email et une
      // invitation qu'il contrôle à l'état 'completed', puis obtenir un accès
      // complet à la propriétaire via activateRemplacementSession.
      // Lecture : uniquement la propriétaire (les 3 écrans clients qui lisent
      // cette sous-collection le font tous via structures/{auth.uid}/...).
      match /remplacements/{remplacementId} {
        allow read: if isSignedIn() && request.auth.uid == structureId;
        allow write: if false;
      }
    }

    // ─── EXCHANGES (messagerie) ───────────────────────────────────────────────
    // Lecture : expéditeur, ou parent de l'enfant, ou assmat de la structure
    // Écriture : tout utilisateur connecté peut créer un message
    // Mise à jour : expéditeur OU marquage lu uniquement
    match /exchanges/{messageId} {
      allow read: if isSignedIn() && (
        // Je suis l'expéditeur
        resource.data.senderId == request.auth.uid ||
        resource.data.senderEmail == myEmail() ||
        // Je suis un parent avec cet enfant dans ma liste
        (
          exists(/databases/$(database)/documents/users/$(myEmail())) &&
          get(/databases/$(database)/documents/users/$(myEmail())).data.children is list &&
          get(/databases/$(database)/documents/users/$(myEmail())).data.children.hasAny([resource.data.childId])
        ) ||
        // Je suis l'assmat : l'enfant est dans ma structure
        (
          exists(/databases/$(database)/documents/users/$(myEmail())) &&
          get(/databases/$(database)/documents/users/$(myEmail())).data.structureId is string &&
          exists(/databases/$(database)/documents/structures/$(get(/databases/$(database)/documents/users/$(myEmail())).data.structureId)/children/$(resource.data.childId))
        )
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        // Expéditeur peut modifier son message
        resource.data.senderId == request.auth.uid ||
        resource.data.senderEmail == myEmail() ||
        // N'importe quel membre peut marquer comme lu
        request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['nonLu', 'readByParent', 'readByAssistant'])
      );
      allow delete: if false;
    }

    // ─── EMAIL QUEUE ──────────────────────────────────────────────────────────
    // Jamais lisible côté client. Création uniquement avec validation stricte.
    match /emailQueue/{emailId} {
      allow read: if false;
      allow update, delete: if false;
      allow create: if isSignedIn() &&
        request.resource.data.to is string &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.templateData is map;
    }

    // ─── INVITATIONS ──────────────────────────────────────────────────────────
    // Lecture : uniquement l'invité (son email) OU un professionnel
    // Mise à jour : uniquement l'invité peut marquer son invitation 'completed'
    // Création : tout professionnel connecté avec champs requis
    match /invitations/{invitationId} {
      allow read: if isSignedIn() && (
        resource.data.email == myEmail() ||
        isProfessional()
      );
      allow update: if isSignedIn() &&
        resource.data.email == myEmail() &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['status']) &&
        request.resource.data.status == 'completed';
      allow delete: if false;
      allow create: if isSignedIn() &&
        request.resource.data.email is string &&
        request.resource.data.structureId is string &&
        (request.resource.data.childId is string ||
         request.resource.data.type == 'mamMember') &&
        request.resource.data.status is string &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.expiresAt is timestamp;
    }

    // ─── HORAIRES HISTORY (racine) ────────────────────────────────────────────
    match /horaires_history/{docId} {
      allow read, write: if isSignedIn();
    }

    // ─── NOTIFICATIONS ────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        resource.data.recipientUserId == request.auth.token.email ||
        resource.data.recipientUserId == myEmail() ||
        resource.data.recipientUserId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        resource.data.recipientUserId == request.auth.token.email ||
        resource.data.recipientUserId == myEmail() ||
        resource.data.recipientUserId == request.auth.uid
      ) && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(['appDelivered', 'appDeliveredAt']);
      allow create, delete: if false;
    }

    // ─── ENGAGEMENTS RÉCIPROQUES ──────────────────────────────────────────────
    // Seul le propriétaire (userId == uid) peut lire/écrire ses engagements.
    // Sous-collections : brouillons/ et historique/
    match /engagements_reciproques/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      match /brouillons/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /historique/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // ─── CONTRATS CDI ─────────────────────────────────────────────────────────
    // Seul le propriétaire (userId == uid) peut lire/écrire ses contrats CDI.
    // Sous-collections : brouillons/ et historique/
    match /contrats_cdi/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      match /brouillons/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /historique/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // ─── CONTRATS CDD ─────────────────────────────────────────────────────────
    // Seul le propriétaire (userId == uid) peut lire/écrire ses contrats CDD.
    // Sous-collections : brouillons/ et historique/
    match /contrats_cdd/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      match /brouillons/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /historique/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // ─── TOUT LE RESTE : bloqué par défaut ───────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
